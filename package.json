{
  "name": "twitch-moderator-app",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.wanty.moderator",
    "productName": "Wanty Moderator",
    "asar": false,
    "files": ["main.js", "preload.js", "index.html", "style.css", "renderer.js", "python/**/*"],
    "win": {
      "target": ["nsis"],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Wanty Moderator"
    }
  }
}